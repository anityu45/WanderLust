<% layout("layouts/boilerplate") %>

<section class="page-heading">
    <h1>All Listings</h1>
    <p>Find cozy homes, beach villas, mountain cabins, and city apartments.</p>
</section>

<div class="listing-grid">
    <% for (let listing of allListings) { %>
        <article class="listing-card">
            <a href="/listings/<%= listing._id %>" class="listing-card-link">
                <img src="<%= listing.imageUrl %>" alt="<%= listing.title || 'Listing image' %>" class="listing-img">
                <div class="listing-info">
                    <h2><%= listing.title || 'Untitled listing' %></h2>
                    <p><%= listing.location || 'Location not added' %>, <%= listing.country || 'Country not added' %></p>
                    <span>
                        <% if (listing.price != null) { %>
                            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                        <% } else { %>
                            Price not added
                        <% } %>
                    </span>
                </div>
            </a>
        </article>
    <% } %>
</div>
