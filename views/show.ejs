<% layout("layouts/boilerplate") %>
<% const currentUser = typeof currUser !== "undefined" ? currUser : null; %>

<section class="show-page">
    <img src="<%= listing.image || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb' %>" alt="<%= listing.title || 'Listing image' %>" class="show-img">

    <div class="show-content">
        <p class="eyebrow"><%= listing.location || 'Location not added' %>, <%= listing.country || 'Country not added' %></p>
        <h1><%= listing.title || 'Untitled listing' %></h1>
        <p class="show-price">
            <% if (listing.price != null) { %>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
            <% } else { %>
                Price not added
            <% } %>
        </p>
        <p class="show-description"><%= listing.description || 'Description not added.' %></p>

        <div class="actions">
            <a class="btn secondary" href="/listings/<%= listing._id %>/edit">Edit Listing</a>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn danger">Delete</button>
            </form>
        </div>
    </div>
</section>

<section class="map-section" style="margin: 2rem 0;">
    <h3 style="margin-bottom: 1rem;">Where you'll be</h3>
    <div id="map" style="width: 100%; height: 400px; border-radius: 12px; border: 1px solid #ddd; background-color: #f8f9fa;"></div>
</section>

<section class="reviews-section">
    <div class="reviews-header">
        <div>
            <p class="eyebrow">Guest reviews</p>
            <h2>Ratings and reviews</h2>
        </div>
        <p class="review-count"><%= listing.reviews ? listing.reviews.length : 0 %> review<%= listing.reviews && listing.reviews.length === 1 ? "" : "s" %></p>
    </div>

    <% if (currentUser) { %>
        <form class="review-form needs-validation" method="post" action="/listings/<%= listing._id %>/reviews" novalidate>
            <div class="rating-input-container">
                <label for="rating">Rating</label>
                <div id="rating-stars" class="rating-stars">
                    <span class="star" data-value="1" title="Poor">★</span>
                    <span class="star" data-value="2" title="Fair">★</span>
                    <span class="star" data-value="3" title="Good">★</span>
                    <span class="star" data-value="4" title="Very good">★</span>
                    <span class="star" data-value="5" title="Excellent">★</span>
                </div>
                <input type="hidden" name="review[rating]" id="rating" class="form-control" required>
                <div class="invalid-feedback">Please choose a rating.</div>
            </div>
            <label for="review-comment">Review</label>
            <textarea name="review[comment]" id="review-comment" placeholder="Share what stood out about this stay" class="form-control" required></textarea>
            <div class="invalid-feedback">Please leave a review.</div>
            <button class="btn primary mt-3">Post Review</button>
        </form>
    <% } else { %>
        <p class="login-prompt">You must be logged in to leave a review.</p>
    <% } %>

    <div class="review-list">
        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% for (let review of listing.reviews) { %>
                <article class="review-card">
                    <div class="review-meta">
                        <span class="stars">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <span class="<%= i <= review.rating ? 'filled-star' : 'empty-star' %>">★</span>
                            <% } %>
                        </span>
                        <% if (review.createdAt) { %>
                            <span><%= review.createdAt.toLocaleDateString("en-IN") %></span>
                        <% } %>
                    </div>
                    <p><%= review.comment %></p>
                    <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                        <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn danger small">Delete Review</button>
                        </form>
                    <% } %>
                </article>
            <% } %>
        <% } else { %>
            <p class="empty-reviews">No reviews yet. Be the first to rate this listing.</p>
        <% } %>
    </div>
</section>

<style>
    .rating-input-container { margin-bottom: 1rem; }
    .rating-stars { font-size: 1.5rem; cursor: pointer; display: inline-block; line-height: 1; }
    .rating-stars .star { color: #ccc; transition: color 0.2s ease-in-out; display: inline-block; }
    .rating-stars .star.hovered, .rating-stars .star.selected { color: gold; }
    .rating-stars.is-invalid-stars .star { color: #dc3545; }
    .review-card .stars { font-size: 1.2rem; line-height: 1; display: inline-block; margin-right: 0.5rem; }
    .review-card .stars .filled-star { color: gold; }
    .review-card .stars .empty-star { color: #ccc; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // --- 1. SAFE MAPTILER SETUP ENGINE ---
        const maptilerApiKey = '<%= maptilerApiKey %>';
        
        // Anti-Crash Trap fallback logic: defaults to New Delhi coordinates [lng, lat] if database values are missing
        const coordinates = <%- JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;

        // Ensure key exists before rendering map instance to prevent client console execution crash
        if (!maptilerApiKey) {
            console.error("MapTiler Key initialization configuration failure: Key is undefined.");
            document.getElementById('map').innerHTML = "<p style='padding: 1rem; color: #721c24;'>Map services temporarily unavailable.</p>";
        } else {
            try {
                // Instantiating MapLibre Instance Engine
                const map = new maplibregl.Map({
                    container: 'map',
                    style: `https://api.maptiler.com/maps/streets-v2/style.json?key=${maptilerApiKey}`,
                    center: coordinates,
                    zoom: 11
                });

                // Standard Top Corner Control Nav Extensions
                map.addControl(new maplibregl.NavigationControl(), 'top-right');

                // Custom Styled Drop Location Pin Implementation
                new maplibregl.Marker({ color: '#fe424d' })
                    .setLngLat(coordinates)
                    .setPopup(new maplibregl.Popup({ offset: 25 }).setHTML('<h4><%= listing.title %></h4><p>Exact location provided after booking</p>'))
                    .addTo(map);
            } catch (mapError) {
                console.error("Map failed to load successfully:", mapError);
            }
        }


        // --- 2. INTERACTIVE STAR RATINGS SYSTEM ---
        const ratingStarsContainer = document.getElementById('rating-stars');
        const ratingInput = document.getElementById('rating');
        const stars = ratingStarsContainer ? ratingStarsContainer.querySelectorAll('.star') : [];
        let currentRating = 0;

        if (ratingStarsContainer && ratingInput) {
            function updateStars(ratingToDisplay) {
                stars.forEach(star => {
                    const starValue = parseInt(star.dataset.value);
                    if (starValue <= ratingToDisplay) {
                        star.classList.add('selected');
                    } else {
                        star.classList.remove('selected');
                    }
                });
            }

            stars.forEach(star => {
                star.addEventListener('mouseover', function() { updateStars(parseInt(this.dataset.value)); });
                star.addEventListener('mouseout', function() { updateStars(currentRating); });
                star.addEventListener('click', function() {
                    currentRating = parseInt(this.dataset.value);
                    ratingInput.value = currentRating;
                    updateStars(currentRating);
                });
            });

            if (ratingInput.value) {
                currentRating = parseInt(ratingInput.value);
                updateStars(currentRating);
            }

            // Custom Review form lifecycle interceptor
            const reviewForm = document.querySelector('.review-form');
            if (reviewForm) {
                reviewForm.addEventListener('submit', function(event) {
                    if (!ratingInput.value) {
                        ratingInput.setCustomValidity('Please choose a rating.');
                        ratingStarsContainer.classList.add('is-invalid-stars');
                        event.preventDefault();
                        event.stopPropagation();
                    } else {
                        ratingInput.setCustomValidity('');
                        ratingStarsContainer.classList.remove('is-invalid-stars');
                    }

                    if (!reviewForm.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    reviewForm.classList.add('was-validated');
                }, false);
            }
        }
    });
</script>