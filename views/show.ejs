<% layout("layouts/boilerplate") %>
<% const currentUser = typeof currUser !== "undefined" ? currUser : null; %>
<% const safeMaptilerApiKey = typeof maptilerApiKey !== "undefined" ? maptilerApiKey : ""; %>
<%
    const rawCoordinates = listing.geometry && Array.isArray(listing.geometry.coordinates)
        ? listing.geometry.coordinates
        : [];
    const hasRealCoordinates = rawCoordinates.length === 2 &&
        rawCoordinates.every((coordinate) => Number.isFinite(coordinate)) &&
        !(rawCoordinates[0] === 77.2090 && rawCoordinates[1] === 28.6139);
    const mapCoordinates = hasRealCoordinates ? rawCoordinates : null;
%>

<section class="show-page">
    <img src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1506744038136-46273834b3fb' %>" alt="<%= listing.title || 'Listing image' %>" class="show-img">

    <div class="show-content">
        <p class="eyebrow"><%= listing.location || 'Location not added' %>, <%= listing.country || 'Country not added' %></p>
        <h1><%= listing.title || 'Untitled listing' %></h1>
        <p class="show-price">
            <% if (listing.price != null) { %>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
            <% } else { %>
                Price not added
            <% } %>
        </p>
        <p class="show-description"><%= listing.description || 'Description not added.' %></p>

        <div class="actions">
            <a class="btn secondary" href="/listings/<%= listing._id %>/edit">Edit Listing</a>
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn danger">Delete</button>
            </form>
        </div>
    </div>
</section>

<section class="map-section">
    <h3>Where you'll be</h3>
    <div id="map" class="listing-map">
        <p class="map-fallback">Map is unavailable right now.</p>
    </div>
</section>

<section class="reviews-section">
    <div class="reviews-header">
        <div>
            <p class="eyebrow">Guest reviews</p>
            <h2>Ratings and reviews</h2>
        </div>
        <p class="review-count"><%= listing.reviews ? listing.reviews.length : 0 %> review<%= listing.reviews && listing.reviews.length === 1 ? "" : "s" %></p>
    </div>

    <% if (currentUser) { %>
        <form class="review-form needs-validation" method="post" action="/listings/<%= listing._id %>/reviews"
            novalidate>
            <div class="rating-input-container">
                <label for="rating">Rating</label>
                <div id="rating-stars" class="rating-stars">
                    <span class="star" data-value="1" title="Poor">★</span>
                    <span class="star" data-value="2" title="Fair">★</span>
                    <span class="star" data-value="3" title="Good">★</span>
                    <span class="star" data-value="4" title="Very good">★</span>
                    <span class="star" data-value="5" title="Excellent">★</span>
                </div>
                <input type="hidden" name="review[rating]" id="rating" class="form-control" required>
                <div class="invalid-feedback">Please choose a rating.</div>
            </div>
            <label for="review-comment">Review</label>
            <textarea name="review[comment]" id="review-comment" placeholder="Share what stood out about this stay"
                class="form-control" required></textarea>
                <div class="invalid-feedback">Please leave a review.</div>
            <button class="btn primary mt-3">Post Review</button>
        </form>
    <% } else { %>
        <p class="login-prompt">You must be logged in to leave a review.</p>
    <% } %>

    <div class="review-list">
        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% for (let review of listing.reviews) { %>
                <article class="review-card">
                    <div class="review-meta">
                        <span class="stars">
                            <% for (let i = 1; i <= 5; i++) { %>
                                <span class="<%= i <= review.rating ? 'filled-star' : 'empty-star' %>">★</span>
                            <% } %>
                        </span>
                        <% if (review.createdAt) { %>
                            <span><%= review.createdAt.toLocaleDateString("en-IN") %></span>
                        <% } %>
                    </div>
                    <p><%= review.comment %></p>
                <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                        <form method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn danger small">Delete Review</button>
                        </form>
                    <% } %>
                </article>
            <% } %>
        <% } else { %>
            <p class="empty-reviews">No reviews yet. Be the first to rate this listing.</p>
        <% } %>
    </div>
</section>

<style>
    /* Styling for the interactive rating input */
    .rating-input-container {
        margin-bottom: 1rem;
    }

    .rating-stars {
        font-size: 1.5rem; /* Adjust size as needed */
        cursor: pointer;
        display: inline-block;
        line-height: 1; /* Align stars properly */
    }

    .rating-stars .star {
        color: #ccc; /* Default star color */
        transition: color 0.2s ease-in-out;
        display: inline-block; /* Ensure stars are side-by-side */
    }

    .rating-stars .star.hovered,
    .rating-stars .star.selected {
        color: gold; /* Highlighted/selected star color */
    }

    /* Style for invalid rating input */
    .rating-stars.is-invalid-stars .star {
        color: #dc3545; /* Bootstrap danger color */
    }

    /* Styling for displaying existing reviews */
    .review-card .stars {
        font-size: 1.2rem; /* Adjust size for displayed stars */
        line-height: 1;
        display: inline-block;
        margin-right: 0.5rem;
    }

    .review-card .stars .filled-star {
        color: gold;
    }

    .review-card .stars .empty-star {
        color: #ccc;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const mapElement = document.getElementById('map');
        const maptilerApiKey = <%- JSON.stringify(safeMaptilerApiKey) %>;
        const coordinates = <%- JSON.stringify(mapCoordinates) %>;
        const hasValidCoordinates = coordinates &&
            Array.isArray(coordinates) &&
            coordinates.length === 2 &&
            coordinates.every(function(coordinate) {
                return Number.isFinite(coordinate);
            });

        if (mapElement && maptilerApiKey && hasValidCoordinates && window.maplibregl) {
            const map = new maplibregl.Map({
                container: 'map',
                style: `https://api.maptiler.com/maps/streets-v2/style.json?key=${maptilerApiKey}`,
                center: coordinates,
                zoom: 11
            });

            map.on('error', function(event) {
                console.warn('Map failed to load.', event && event.error ? event.error : event);
                if (mapElement) {
                    mapElement.classList.add('map-unavailable');
                }
            });

            map.addControl(new maplibregl.NavigationControl(), 'top-right');
            new maplibregl.Marker({ color: '#fe424d' })
                .setLngLat(coordinates)
                .addTo(map);
        } else if (mapElement) {
            if (!maptilerApiKey) {
                console.warn('Map unavailable: MAPTILER_API_KEY is not configured on the server.');
            } else if (!hasValidCoordinates) {
                console.warn('Map unavailable: this listing does not have valid geometry coordinates.');
            } else if (!window.maplibregl) {
                console.warn('Map unavailable: MapLibre GL JS did not load.');
            }
            mapElement.classList.add('map-unavailable');
        }

        // --- YOUR ORIGINAL STAR RATINGS SCRIPT ---
        const ratingStarsContainer = document.getElementById('rating-stars');
        const ratingInput = document.getElementById('rating');
        const stars = ratingStarsContainer ? ratingStarsContainer.querySelectorAll('.star') : [];
        let currentRating = 0; // To store the selected rating

        if (ratingStarsContainer && ratingInput) {
            // Function to update star display based on a given rating
            function updateStars(ratingToDisplay) {
                stars.forEach(star => {
                    const starValue = parseInt(star.dataset.value);
                    if (starValue <= ratingToDisplay) {
                        star.classList.add('selected');
                    } else {
                        star.classList.remove('selected');
                    }
                });
            }

            stars.forEach(star => {
                star.addEventListener('mouseover', function() {
                    updateStars(parseInt(this.dataset.value)); // Highlight up to hovered star
                });

                star.addEventListener('mouseout', function() {
                    updateStars(currentRating); // Revert to selected rating or no selection
                });

                star.addEventListener('click', function() {
                    currentRating = parseInt(this.dataset.value);
                    ratingInput.value = currentRating;
                    updateStars(currentRating); // Update visual state immediately
                });
            });

            // Initialize stars if there's a default value (e.g., from validation error)
            if (ratingInput.value) {
                currentRating = parseInt(ratingInput.value);
                updateStars(currentRating);
            }

            // Add validation for the hidden input
            const reviewForm = document.querySelector('.review-form');
            if (reviewForm) {
                reviewForm.addEventListener('submit', function(event) {
                    // Custom validation for the rating input
                    if (!ratingInput.value) {
                        ratingInput.setCustomValidity('Please choose a rating.');
                        // Add is-invalid to the visible rating container for feedback
                        ratingStarsContainer.classList.add('is-invalid-stars');
                        event.preventDefault();
                        event.stopPropagation();
                    } else {
                        ratingInput.setCustomValidity('');
                        ratingStarsContainer.classList.remove('is-invalid-stars');
                    }

                    // Bootstrap's form validation
                    if (!reviewForm.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    reviewForm.classList.add('was-validated');
                }, false);
            }
        }
    });
</script>