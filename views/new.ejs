<% layout("layouts/boilerplate") %>

<section class="form-page">
    <p class="eyebrow">Host your place</p>
    <h1>Create a new listing</h1>

    <form class="listing-form needs-validation" method="post" action="/listings" novalidate enctype="multipart/form-data">
        <label>Title
            <input name="listing[title]" placeholder="Enter title" type="text" required>
            <div class="invalid-feedback">Please enter a title.</div>
        </label>
        <label>Description
            <textarea name="listing[description]" placeholder="Enter description" required></textarea>
            <div class="invalid-feedback">Please enter a description.</div>
        </label>
        <label>Image
            <input name="listing[image]" placeholder="Upload Listing Image" type="file" accept="image/png,image/jpeg,image/webp" required>
            <div class="invalid-feedback">Please choose an image.</div>
        </label>
        <label>Price
            <input name="listing[price]" placeholder="Enter price" type="number" min="0" required>
            <div class="invalid-feedback">Please enter a valid price.</div>
        </label>
        <label>Location
            <input name="listing[location]" placeholder="Enter location" type="text" required>
            <div class="invalid-feedback">Please enter a location.</div>
        </label>
        <label>Country
            <input name="listing[country]" placeholder="Enter country" type="text" required>
            <div class="invalid-feedback">Please enter a country.</div>
        </label>
        <button class="btn primary">Add Listing</button>
    </form>
</section>
